<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Saved or not</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body style="height:100%">
    <p>
        <%= msg %>
    </p>
    <% if(typeof score != 'undefined') {%>
    <div>
        <div class="card">
            <div class="card-header">Score is :-</div>
            <div class="card-body">
                <p class="card-text">
                    <%= score %>
                </p>
            </div>
        </div>
        <div class="card">
            <div class="card-header">comparative is :-</div>
            <div class="card-body">
                <p class="card-text">
                    <%= comparative %>
                </p>
            </div>
        </div>
        <div class="card">
            <div class="card-header">Tokens in submitted post is :-</div>
            <div class="card-body">
                <p class="card-text">
                    <%= tokens %>
                </p>
            </div>
        </div>

        <div class="card">
            <div class="card-header">Words in submitted post is :-</div>
            <div class="card-body">
                <p class="card-text">
                    <%= words %>
                </p>
            </div>
        </div>

        <div class="card">
            <div class="card-header">Positive words in submitted post is :-</div>
            <div class="card-body">
                <p class="card-text">
                    <%= positive %>
                </p>
            </div>
        </div>

        <div class="card">
            <div class="card-header">Negative in submitted post is :-</div>
            <div class="card-body">
                <p class="card-text">
                    <%= negative %>
                </p>
            </div>
        </div>
    </div>
    <% } %>


</body>

</html>