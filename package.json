{
  "name": "sentiment-analysis",
  "version": "1.0.0",
  "description": "Sentiment analysis app with Express, Socket.IO, and Kafka",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file .env src/index.ts",
    "start": "node --env-file .env dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "kafka": "tsx --env-file .env src/kafkaImplementation.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest --run"
  },
  "dependencies": {
    "ejs": "^2.6.1",
    "express": "^4.21.2",
    "kafkajs": "^2.2.4",
    "mongoose": "^5.13.23",
    "sentiment": "^5.0.1",
    "socket.io": "^2.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tsconfig/node22": "^22.0.0",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.2",
    "@types/sentiment": "^5.0.4",
    "@types/socket.io": "^2.1.13",
    "eslint": "^9.17.0",
    "eslint-plugin-perfectionist": "^4.6.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
